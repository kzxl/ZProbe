<Window x:Class="ZeroProbe.UI.Modules.ApiClient.CurlImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nhập Yêu Cầu Từ cURL"
        Width="680" Height="460"
        MinWidth="520" MinHeight="350"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="📥 Nhập Lệnh cURL (cURL to Request)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}" />
            <TextBlock Text="Dán cú pháp lệnh cURL từ trình duyệt (DevTools -> Copy as cURL), Postman, hoặc tài liệu API:" 
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- cURL Input Box -->
        <TextBox x:Name="CurlTextBox" Grid.Row="1"
                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas, 'Cascadia Code', monospace" FontSize="12.5"
                 Background="{StaticResource BgMediumBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                 BorderBrush="{StaticResource BorderBrush}" Padding="10" />

        <!-- Actions -->
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <Button Content="📋 Dán từ Clipboard" Style="{StaticResource SmallActionButton}" Click="PasteClipboard_Click" DockPanel.Dock="Left" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy" Style="{StaticResource SmallActionButton}" Width="80" Margin="0,0,8,0" Click="Cancel_Click" />
                <Button Content="✓ Nhập Yêu Cầu" Style="{StaticResource StartButton}" Width="120" Click="Apply_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
