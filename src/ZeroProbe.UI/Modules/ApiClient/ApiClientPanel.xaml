<UserControl x:Class="ZeroProbe.UI.Modules.ApiClient.ApiClientPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ZeroProbe.UI.Modules.ApiClient.Models"
             xmlns:converters="clr-namespace:ZeroProbe.UI.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToVisibilityConverter x:Key="CustomBoolToVis" />

        <!-- Sub-Tab Item Style -->
        <Style x:Key="SubTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent" 
                                BorderBrush="Transparent" BorderThickness="0,0,0,2" 
                                Padding="{TemplateBinding Padding}" Margin="0,0,4,0" Cursor="Hand">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource BgElevatedBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Action Button -->
        <Style x:Key="SmallActionButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgElevatedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#32385C" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBlueBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12,8,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Top Bar: Method, URL, Send, Preset -->
            <RowDefinition Height="2*" MinHeight="180" /> <!-- Request Pane -->
            <RowDefinition Height="6" />    <!-- Splitter -->
            <RowDefinition Height="3*" MinHeight="220" /> <!-- Response Pane -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════ -->
        <!-- ROW 0: URL BAR & ACTIONS                   -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="10,8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="105" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="170" />
                </Grid.ColumnDefinitions>

                <!-- HTTP Method -->
                <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableMethods}" 
                          SelectedItem="{Binding Method}" FontWeight="Bold"
                          IsEnabled="{Binding IsNotRunning}" Height="34" />

                <!-- URL Address Bar -->
                <TextBox Grid.Column="2" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" 
                         FontFamily="Consolas, Segoe UI" FontSize="13" Height="34" 
                         VerticalContentAlignment="Center" IsEnabled="{Binding IsNotRunning}" />

                <!-- Send Button -->
                <Button Grid.Column="4" Style="{StaticResource StartButton}" Content="▶ SEND" 
                        Height="34" Command="{Binding StartCommand}" />

                <!-- Cancel Button -->
                <Button Grid.Column="6" Style="{StaticResource StopButton}" Content="■ STOP" 
                        Height="34" Command="{Binding StopCommand}" />

                <!-- Presets Combo -->
                <ComboBox Grid.Column="8" Height="34" SelectedIndex="0" 
                          SelectionChanged="PresetComboBox_SelectionChanged"
                          ToolTip="Nạp nhanh các mẫu API test phổ biến">
                    <ComboBoxItem Content="⚡ Mẫu API có sẵn..." />
                    <ComboBoxItem Content="JSONPlaceholder GET" />
                    <ComboBoxItem Content="JSONPlaceholder POST" />
                    <ComboBoxItem Content="HttpBin Headers" />
                    <ComboBoxItem Content="HttpBin POST Form" />
                </ComboBox>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════ -->
        <!-- ROW 1: REQUEST CONFIGURATION PANE           -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="10,8">
            <TabControl Background="Transparent" BorderThickness="0">
                <!-- 1. Headers Tab -->
                <TabItem Header="Headers" Style="{StaticResource SubTabItemStyle}">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DataGrid Grid.Row="0" ItemsSource="{Binding Headers}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" Background="Transparent" BorderThickness="1"
                                  BorderBrush="{StaticResource BorderBrush}" RowHeight="30">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Bật" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="50" />
                                <DataGridTextColumn Header="Header Name" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                                <DataGridTextColumn Header="Header Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="3*" />
                                <DataGridTemplateColumn Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕" Style="{StaticResource SmallActionButton}" 
                                                    Command="{Binding DataContext.RemoveHeaderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" Padding="6,1" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="+ Thêm Header" Style="{StaticResource SmallActionButton}" 
                                    Command="{Binding AddHeaderCommand}" Margin="0,0,8,0" />
                            <Button Content="+ Content-Type: application/json" Style="{StaticResource SmallActionButton}" 
                                    Click="AddJsonHeader_Click" Margin="0,0,8,0" />
                            <Button Content="+ Accept: application/json" Style="{StaticResource SmallActionButton}" 
                                    Click="AddAcceptHeader_Click" />
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- 2. Query Params Tab -->
                <TabItem Header="Params" Style="{StaticResource SubTabItemStyle}">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DataGrid Grid.Row="0" ItemsSource="{Binding QueryParams}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" Background="Transparent" BorderThickness="1"
                                  BorderBrush="{StaticResource BorderBrush}" RowHeight="30">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Bật" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="50" />
                                <DataGridTextColumn Header="Param Name" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                                <DataGridTextColumn Header="Param Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="3*" />
                                <DataGridTemplateColumn Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕" Style="{StaticResource SmallActionButton}" 
                                                    Command="{Binding DataContext.RemoveParamCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" Padding="6,1" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="+ Thêm Tham Số (Param)" Style="{StaticResource SmallActionButton}" 
                                    Command="{Binding AddParamCommand}" />
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- 3. Body Tab -->
                <TabItem Header="Body" Style="{StaticResource SubTabItemStyle}">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Body Mode Selectors -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                            <TextBlock Text="Định dạng Body:" Style="{StaticResource FieldLabel}" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding AvailableBodyModes}" SelectedItem="{Binding BodyMode}" 
                                      Width="160" Height="28" VerticalAlignment="Center" Margin="0,0,14,0" />
                            <Button Content="✨ Format JSON (Prettify)" Style="{StaticResource SmallActionButton}" 
                                    Command="{Binding FormatJsonBodyCommand}" />
                        </StackPanel>

                        <!-- Body Editor -->
                        <TextBox Grid.Row="1" Text="{Binding BodyText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas, 'Cascadia Code', monospace" FontSize="12.5"
                                 Background="{StaticResource BgDarkBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource BorderBrush}" Padding="8" />
                    </Grid>
                </TabItem>

                <!-- 4. Auth Tab -->
                <TabItem Header="Auth" Style="{StaticResource SubTabItemStyle}">
                    <StackPanel Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Kiểu Xác Thực (Auth):" Style="{StaticResource FieldLabel}" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding AvailableAuthModes}" SelectedItem="{Binding AuthMode}" Width="160" Height="28" />
                        </StackPanel>

                        <!-- Bearer Token -->
                        <StackPanel Visibility="{Binding IsBearerAuth, Converter={StaticResource CustomBoolToVis}}" Margin="0,0,0,8">
                            <TextBlock Text="Bearer Token:" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding AuthToken, UpdateSourceTrigger=PropertyChanged}" 
                                     FontFamily="Consolas" Height="30" VerticalContentAlignment="Center" />
                        </StackPanel>

                        <!-- Basic Auth -->
                        <Grid Visibility="{Binding IsBasicAuth, Converter={StaticResource CustomBoolToVis}}" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Username:" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding AuthUser, UpdateSourceTrigger=PropertyChanged}" Height="30" VerticalContentAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Password:" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding AuthPass, UpdateSourceTrigger=PropertyChanged}" Height="30" VerticalContentAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- API Key -->
                        <Grid Visibility="{Binding IsApiKeyAuth, Converter={StaticResource CustomBoolToVis}}" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Header Key Name:" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding ApiKeyName, UpdateSourceTrigger=PropertyChanged}" Height="30" VerticalContentAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="API Key Value:" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding ApiKeyValue, UpdateSourceTrigger=PropertyChanged}" Height="30" VerticalContentAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Border>

        <!-- ═══════════════════════════════════════════ -->
        <!-- ROW 2: SPLITTER                             -->
        <!-- ═══════════════════════════════════════════ -->
        <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center" 
                      Background="{StaticResource BorderBrush}" Cursor="SizeNS" Margin="0,1" />

        <!-- ═══════════════════════════════════════════ -->
        <!-- ROW 3: RESPONSE INSPECTOR PANE              -->
        <!-- ═══════════════════════════════════════════ -->
        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="10,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Response Banner: Status Badge, Time, Size, Actions -->
                    <RowDefinition Height="*" />    <!-- Response Tabs (Body, Headers, History) -->
                </Grid.RowDefinitions>

                <!-- Response Status Banner -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Status Code Badge -->
                    <Border Grid.Column="0" Background="#1D2034" BorderBrush="{Binding StatusColor}" 
                            BorderThickness="1.5" CornerRadius="5" Padding="10,3" Margin="0,0,10,0">
                        <TextBlock Text="{Binding ResponseStatusText}" FontWeight="Bold" FontSize="12.5" 
                                   Foreground="{Binding StatusColor}" />
                    </Border>

                    <!-- Elapsed Time Badge -->
                    <Border Grid.Column="1" Background="#1D2034" CornerRadius="5" Padding="8,3" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏱ " FontSize="11" />
                            <TextBlock Text="{Binding ElapsedText}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Payload Size Badge -->
                    <Border Grid.Column="2" Background="#1D2034" CornerRadius="5" Padding="8,3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📦 " FontSize="11" />
                            <TextBlock Text="{Binding SizeText}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Pretty / Raw Toggle -->
                    <CheckBox Grid.Column="4" Content="JSON Định Dạng Đẹp" IsChecked="{Binding IsPrettyView}" 
                              VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" />

                    <!-- Copy Response Body -->
                    <Button Grid.Column="6" Content="📋 Sao Chép Kết Quả" Style="{StaticResource SmallActionButton}" 
                            Command="{Binding CopyResponseCommand}" />
                </Grid>

                <!-- Response Content Tabs -->
                <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                    <!-- Response Body Tab -->
                    <TabItem Header="Response Body" Style="{StaticResource SubTabItemStyle}">
                        <TextBox Text="{Binding ResponseDisplayBody, Mode=OneWay}" IsReadOnly="True"
                                 AcceptsReturn="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas, 'Cascadia Code', monospace" FontSize="12.5"
                                 Background="{StaticResource BgDarkBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource BorderBrush}" Padding="8" Margin="0,6,0,0" />
                    </TabItem>

                    <!-- Response Headers Tab -->
                    <TabItem Header="Response Headers" Style="{StaticResource SubTabItemStyle}">
                        <DataGrid ItemsSource="{Binding ResponseHeaders}" AutoGenerateColumns="False"
                                  IsReadOnly="True" Background="Transparent" BorderThickness="1"
                                  BorderBrush="{StaticResource BorderBrush}" RowHeight="28" Margin="0,6,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Header Name" Binding="{Binding Key}" Width="250" />
                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <!-- Session History Tab -->
                    <TabItem Header="Lịch Sử Yêu Cầu" Style="{StaticResource SubTabItemStyle}">
                        <Grid Margin="0,6,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ListBox Grid.Row="0" ItemsSource="{Binding History}" Background="{StaticResource BgDarkBrush}"
                                     BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}" 
                                                BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Method}" FontWeight="Bold" 
                                                           Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,10,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding Url}" TextTrimming="CharacterEllipsis" 
                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                                <TextBlock Grid.Column="2" Text="{Binding StatusCode}" FontWeight="SemiBold" 
                                                           Foreground="{StaticResource AccentGreenBrush}" Margin="10,0" />
                                                <Button Grid.Column="3" Content="Nạp lại" Style="{StaticResource SmallActionButton}"
                                                        Command="{Binding DataContext.LoadHistoryItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}" Padding="8,2" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Right">
                                <Button Content="Xóa Lịch Sử" Style="{StaticResource SmallActionButton}" 
                                        Command="{Binding ClearHistoryCommand}" />
                            </StackPanel>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
